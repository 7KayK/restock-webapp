NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

DATABASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Kay's standalone price-collection service (Restock_Shared_Price_Service).
# Defaults to the local dev server (python price_service.py serve) when unset
# — leave unset in production until the service is actually deployed.
PRICE_SERVICE_BASE_URL=http://127.0.0.1:8080

# Restock Readiness Assessment (waitlist qualification quiz modal)
# Master kill switch — keep "false" until sanity-checked on staging.
NEXT_PUBLIC_ASSESSMENT_ENABLED=false
# "delay" (default, auto-popup a few seconds after page load) | "exit-intent" (not yet implemented) | "off"
NEXT_PUBLIC_ASSESSMENT_TRIGGER=delay
