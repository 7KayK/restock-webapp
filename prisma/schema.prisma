generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(cuid())
  clerkId           String            @unique
  email             String            @unique
  telegramId        String?           @unique
  whatsappNumber    String?           @unique
  // Single "current location" (kept deliberately simple — no saved
  // address book yet). locationLabel is a coarse, human-readable
  // city/region/country string for display; lat/lng are the precise
  // coordinates actually used for nearby-store distance calculations.
  locationLabel     String?
  locationLat       Float?
  locationLng       Float?
  locationUpdatedAt DateTime?
  createdAt         DateTime          @default(now())
  purchases         Purchase[]
  reminders         Reminder[]
  teamsOwned        Team[]            @relation("TeamOwner")
  teamMemberships   TeamMember[]
  integrations      UserIntegration[]
  priceSightings    PriceSighting[]
  shoppingListItems ShoppingListItem[]
  shoppingList      ShoppingList?
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  item      String
  quantity  Float
  unit      String?
  category  String?
  price     Float?
  source    String   @default("manual")
  createdAt DateTime @default(now())
}

model Reminder {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id])
  item          String
  predictedDate DateTime
  confidence    Float
  active        Boolean   @default(true)
  snoozedUntil  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Team {
  id        String       @id @default(cuid())
  name      String
  ownerId   String
  owner     User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members   TeamMember[]
  purchases Purchase[]
  reminders Reminder[]
  createdAt DateTime     @default(now())
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
}

model UserIntegration {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  provider     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
}

// A single reported (or, later, scraped) price for an item at a store.
// Crowdsourced sightings are the primary source for now — a user taps
// "I saw this here for $X" while shopping. storeLat/storeLng are captured
// at report time (from Places, when the store was picked from search) so
// distance-based ranking can be added later without a backfill.
// `source` distinguishes a crowdsourced report from a future store-website
// price feed or a manually-seeded reference price, so both can coexist.
model PriceSighting {
  id           String   @id @default(cuid())
  item         String
  storeName    String
  storePlaceId String?
  storeLat     Float?
  storeLng     Float?
  price        Float
  currency     String
  unit         String?
  source       String   @default("crowdsourced")
  reportedById String?
  reportedBy   User?    @relation(fields: [reportedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([item])
  @@index([storePlaceId])
}

// The shopper's actual current shopping list, as they've edited it. Seeded
// once from the auto-generated "smart" suggestions (due reminders +
// overdue-by-average-interval predicted items) the first time the list is
// empty, then the client syncs the whole list here on every change — so
// manual adds/edits/removes survive a reload or a switch to another device,
// instead of only living in that browser tab's React state. `position`
// preserves on-screen order across a delete-all-and-recreate sync, which is
// simpler and safe at this list's size than diffing individual rows.
model ShoppingListItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  name       String
  quantity   Int      @default(1)
  unit       String?
  category   String?
  source     String   @default("manual")
  reminderId String?
  // Short, human-readable context for why this item is on the list — e.g.
  // "Running low - about 3 days remaining" from Pantry, or "Usually bought
  // every 12 days" from the smart-list predictor. Null for a plain manual
  // add, where there's nothing to explain.
  reason     String?
  done       Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// Optimistic-concurrency counter for a shopper's persisted list. Every write
// to their ShoppingListItem rows (edit sync, regenerate, trip completion)
// bumps `revision` under the same lock; a client saving from an older
// revision than the current one is rejected instead of overwriting whatever
// another device saved in between. A missing row means revision 0 (nothing
// has been written since this table existed). Its own table, rather than a
// column on User, so the shared User table the bots read is untouched.
model ShoppingList {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id])
  revision  Int      @default(0)
  // Whether an empty list should be refilled with suggestions on the next
  // load. True for a brand-new list and after a completed trip (the system
  // emptied it); false once the shopper saves an empty list themselves, so
  // clearing the list on purpose isn't undone by a reload.
  reseedWhenEmpty Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model Waitlist {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  country   String?
  phone     String?
  segment   String?
  score     Int?
  answers   Json?
  createdAt DateTime @default(now())
}
