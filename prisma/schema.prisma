generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(cuid())
  clerkId           String            @unique
  email             String            @unique
  telegramId        String?           @unique
  whatsappNumber    String?           @unique
  // Single "current location" (kept deliberately simple — no saved
  // address book yet). locationLabel is a coarse, human-readable
  // city/region/country string for display; lat/lng are the precise
  // coordinates actually used for nearby-store distance calculations.
  locationLabel     String?
  locationLat       Float?
  locationLng       Float?
  locationUpdatedAt DateTime?
  createdAt         DateTime          @default(now())
  purchases         Purchase[]
  reminders         Reminder[]
  teamsOwned        Team[]            @relation("TeamOwner")
  teamMemberships   TeamMember[]
  integrations      UserIntegration[]
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  item      String
  quantity  Float
  unit      String?
  category  String?
  price     Float?
  source    String   @default("manual")
  createdAt DateTime @default(now())
}

model Reminder {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id])
  item          String
  predictedDate DateTime
  confidence    Float
  active        Boolean   @default(true)
  snoozedUntil  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Team {
  id        String       @id @default(cuid())
  name      String
  ownerId   String
  owner     User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members   TeamMember[]
  purchases Purchase[]
  reminders Reminder[]
  createdAt DateTime     @default(now())
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
}

model UserIntegration {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  provider     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
}

model Waitlist {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  country   String?
  phone     String?
  segment   String?
  score     Int?
  answers   Json?
  createdAt DateTime @default(now())
}
